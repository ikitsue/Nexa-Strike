{
  "name": "cs2-utility-desktop",
  "version": "1.4.1",
  "description": "NexaStrike desktop app",
  "main": "public/electron.js",
  "homepage": "./",
  "scripts": {
    "predev": "node ../scripts/set-version.js",
    "dev": "vite",
    "prestart": "node ../scripts/set-version.js",
    "start": "vite build && electron .",
    "prebuild": "node ../scripts/set-version.js --bump",
    "build": "vite build && electron-builder"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@supabase/supabase-js": "^2.108.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.6.0",
    "electron-updater": "^6.8.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^8.2.2",
    "electron": "^43.8.1",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^1.0.0",
    "vite": "^8.1.3",
    "wait-on": "^7.0.1"
  },
  "overrides": {
    "follow-redirects": "^1.16.1"
  },
  "build": {
    "appId": "com.cs2utility.app",
    "productName": "NexaStrike",
    "artifactName": "NexaStrike-Setup-${version}.${ext}",
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js",
      "public/nexastrike-icon.png",
      "public/nexastrike-icon.ico"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "icon": "public/nexastrike-icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ikitsue",
        "repo": "Nexa-Strike"
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
