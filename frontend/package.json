{
  "name": "cs2-utility-frontend",
  "version": "1.4.6",
  "description": "Frontend for CS2 Utility App",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@supabase/supabase-js": "^2.108.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.4",
    "sharp": "0.35.5",
    "zustand": "^4.4.0"
  },
  "scripts": {
    "predev": "node ../scripts/set-version.js",
    "dev": "vite --port 3001",
    "prebuild": "node ../scripts/set-version.js --bump",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "migrate:images": "node scripts/migrate-supabase-images.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.3"
  },
  "overrides": {
    "follow-redirects": "^1.16.2"
  }
}
