{
  "version": 2,
  "builds": [
    {
      "src": "api/media.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!_vercel/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
